{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "group:all"],
  "timezone": "Europe/Warsaw",
  "schedule": ["* 6-9 1 * *"], // First day of each month, 06:00–09:59 (Europe/Warsaw).
  "minimumReleaseAge": "7 days",
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": false,
  "packageRules": [
    {
      "description": "Keep Vitest within the range supported by @cloudflare/vitest-plugin; revisit when the plugin supports Vitest 5.",
      "matchPackageNames": ["vitest"],
      "allowedVersions": "^4.1.0",
    },
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "groupName": "all dependencies",
    "groupSlug": "all",
    "schedule": ["* 6-9 1 * *"], // First day of each month, 06:00–09:59 (Europe/Warsaw).
  },
}
